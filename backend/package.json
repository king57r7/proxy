{
  "name": "proxy-platform-api",
  "version": "1.0.0",
  "description": "Production-ready Proxy Management Platform API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn src/index.ts",
