    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "joi": "^17.11.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "crypto-js": "^4.1.1",
    "@supabase/supabase-js": "^2.38.4",
    "pg": "^8.11.3",
    "date-fns": "^2.30.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "lodash": "^4.17.21",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
