# ============================================================================
# PROXY PLATFORM - BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in all values
# ============================================================================

# Environment
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ============================================================================
# SUPABASE CONFIGURATION
# Get from https://supabase.com project settings
# ============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database (optional - use if connecting directly)
DATABASE_URL=postgresql://postgres:password@localhost:5432/proxy_platform

# ============================================================================
# JWT AUTHENTICATION
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

JWT_SECRET=your_jwt_secret_key_generate_with_crypto
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# ============================================================================
# ENCRYPTION
# All sensitive data like proxy passwords are encrypted with this key
# ============================================================================

ENCRYPTION_KEY=your_encryption_key_generate_with_crypto_32_bytes
ENCRYPTION_ALGORITHM=aes-256-cbc

# ============================================================================
# PAYMENT PROVIDERS
# ============================================================================

# Stripe (https://stripe.com)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal (https://developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox

# Razorpay (https://razorpay.com)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ============================================================================
# EMAIL CONFIGURATION
# Using Nodemailer - Gmail example
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@proxyplatform.com
SMTP_FROM_NAME=Proxy Platform

# Alternative: SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key

# ============================================================================
# PROXY PROVIDERS CONFIGURATION
# Add your actual proxy provider credentials here
# ============================================================================

# Example Proxy Provider (replace with actual provider)
PROXY_PROVIDER_API_KEY=your_proxy_provider_api_key
PROXY_PROVIDER_API_SECRET=your_proxy_provider_api_secret
PROXY_PROVIDER_ENDPOINT=https://api.proxy-provider.com

# ============================================================================
# REDIS CONFIGURATION
# For caching and job queues
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# AWS S3 (Optional - for file uploads)
# ============================================================================

AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=proxy-platform-bucket
AWS_S3_REGION=us-east-1

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

LOG_LEVEL=info
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ============================================================================
# FRONTEND CONFIGURATION
# For CORS
# ============================================================================

FRONTEND_URL=http://localhost:3001
ADMIN_FRONTEND_URL=http://localhost:3002

# ============================================================================
# API RATE LIMITING
# ============================================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# FEATURE FLAGS
# ============================================================================

FEATURE_REFERRAL=true
FEATURE_COUPONS=true
FEATURE_SMART_SELECT=true
FEATURE_AUTO_PROXY_SELECTION=true
FEATURE_ANALYTICS=true

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================

ADMIN_EMAIL=admin@proxyplatform.com
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password

# ============================================================================
# APP CONFIGURATION
# ============================================================================

MIN_APP_VERSION=1.0.0
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance

# ============================================================================
# PROXY TESTING CONFIGURATION
# ============================================================================

PROXY_TEST_TIMEOUT_MS=5000
PROXY_TEST_URL=http://ipinfo.io/json
PROXY_HEALTH_CHECK_INTERVAL_MINUTES=60

# ============================================================================
# WEBHOOKS
# ============================================================================

WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret

# ============================================================================
# ANALYTICS
# ============================================================================

ANALYTICS_ENABLED=true
TRACK_USER_CONNECTIONS=true
COLLECT_USAGE_STATS=true

# ============================================================================
# DEBUG
# ============================================================================

DEBUG=proxy:*
